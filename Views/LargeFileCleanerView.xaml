<UserControl x:Class="PersonalToolbox.Views.LargeFileCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="920">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D9DEE7" />
        <SolidColorBrush x:Key="TextMuted" Color="#667085" />
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="大文件清理工具" FontSize="26" FontWeight="SemiBold" Foreground="#1D2733" />
                <TextBlock Text="选择目录后扫描大文件，勾选不需要的文件并移入回收站。" Margin="0,6,0,0" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="开始扫描" Command="{Binding ScanCommand}" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Margin="4,0" />
                <Button Content="停止" Command="{Binding CancelCommand}" Margin="4,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="扫描目录" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="最小大小 MB" Foreground="{StaticResource TextMuted}" Margin="14,0,0,6" />

                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="1" Content="浏览" Command="{Binding BrowseCommand}" Margin="8,0,4,0" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MinimumSizeMbText, UpdateSourceTrigger=PropertyChanged}" Margin="14,0,0,0" />
                <Button Grid.Row="1" Grid.Column="3" Content="选择全部" Command="{Binding SelectAllCommand}" Margin="12,0,4,0" />
                <Button Grid.Row="1" Grid.Column="4" Content="取消选择" Command="{Binding ClearSelectionCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="White" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Files}"
                      SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="选中" Width="70" />
                    <DataGridTextColumn Binding="{Binding Name}" Header="文件名" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Header="大小" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Binding="{Binding LastWriteTimeText}" SortMemberPath="LastWriteTime" Header="修改时间" IsReadOnly="True" Width="170" />
                    <DataGridTextColumn Binding="{Binding Folder}" Header="所在目录" IsReadOnly="True" Width="3*" />
                    <DataGridTextColumn Binding="{Binding Path}" Header="完整路径" IsReadOnly="True" Width="4*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ProgressBar Height="8" IsIndeterminate="{Binding IsScanning}" Margin="0,0,0,8">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="打开所在目录" Command="{Binding OpenFolderCommand}" Margin="4,0" />
                <Button Content="删除选中文件" Command="{Binding DeleteSelectedCommand}" Background="#DC2626" Foreground="White" BorderBrush="#DC2626" Margin="4,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
