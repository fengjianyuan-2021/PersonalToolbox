<Window x:Class="PersonalToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:PersonalToolbox.ViewModels"
        xmlns:views="clr-namespace:PersonalToolbox.Views"
        mc:Ignorable="d"
        Title="个人工具箱"
        Height="760"
        MinHeight="620"
        Width="1200"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LargeFileCleanerViewModel}">
            <views:LargeFileCleanerView />
        </DataTemplate>

        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D9DEE7" />
        <SolidColorBrush x:Key="TextMuted" Color="#667085" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172033" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="个人工具箱" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="本地效率工具集合" Foreground="#AAB4C5" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <TextBlock Text="PersonalToolbox" Foreground="#AAB4C5" FontSize="12" />
                    <TextBlock Text="{Binding VersionText}" Foreground="#D8DEE9" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,8"
                                    Background="{Binding IsSelected, Converter={StaticResource BooleanToBrushConverter}}"
                                    BorderBrush="#34405A"
                                    Foreground="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="#C8D1E0" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="18" />
    </Grid>
</Window>
